# Leash (solution/): dependencies, build output, caches and secrets never go into git
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
solution/app/dist/
solution/app/test-results/
solution/app/playwright-report/
.env
.env.*
!.env.example
solution/postman/*.postman_environment.json

# Claude Code: personal settings stay local
.claude/settings.local.json

# LibreOffice lock files
.~lock.*#

# Local simulator runtime state (source fixtures in data/ stay read-only)
output/local-platform-state/

# Laya training data and checkpoints (7 GB): reproducible from the pipeline, never in git
solution/training/

# Pitch build scratch and UI screenshots: regenerable, not evidence
.codex-pitch-build/
output/*.png
