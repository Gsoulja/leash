# Copy to solution/.env (never commit .env). Compose reads it; see RUNBOOK.md section 1.
# Leave TEAM_API_KEY and LEASH_BASE_URL empty for local work: the worker then talks to the local fake platform.
TEAM_API_KEY=
LEASH_BASE_URL=
LEASH_DB_PASSWORD=leash
LEASH_CORS_ORIGINS=http://localhost:5173
# HTTP connection pool to the platform (LEASH-136). The defaults suit one platform host; raise the
# connection limits only if the worker and API share a process under real load.
# LEASH_HTTP_MAX_CONNECTIONS=20
# LEASH_HTTP_MAX_KEEPALIVE_CONNECTIONS=10
# LEASH_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
# LEASH_HTTP_CONNECT_RETRIES=1
# Change a port if something else on the machine already uses it (e.g. LEASH_FAKE_PORT=9010).
# LEASH_API_PORT=8080
# LEASH_WORKER_HEALTH_PORT=8081
# LEASH_FAKE_PORT=9000
# LEASH_DB_PORT=55432
