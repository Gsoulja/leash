# Copy to solution/.env (never commit .env). Compose reads it; see RUNBOOK.md section 1.
# Leave TEAM_API_KEY and LEASH_BASE_URL empty for local work: the worker then talks to the local fake platform.
TEAM_API_KEY=
LEASH_BASE_URL=
LEASH_DB_PASSWORD=leash
LEASH_CORS_ORIGINS=http://localhost:5173
# Change a port if something else on the machine already uses it (e.g. LEASH_FAKE_PORT=9010).
# LEASH_API_PORT=8080
# LEASH_WORKER_HEALTH_PORT=8081
# LEASH_FAKE_PORT=9000
# LEASH_DB_PORT=55432

# HTTP connection pool to the platform (LEASH-136). The defaults suit one platform host; raise the
# connection limits only if the worker and API share a process under real load. A value outside its
# range is a startup error naming the variable, not a default quietly substituted.
# LEASH_HTTP_MAX_CONNECTIONS=20
# LEASH_HTTP_MAX_KEEPALIVE_CONNECTIONS=10
# LEASH_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
# LEASH_HTTP_CONNECT_TIMEOUT_SECONDS=5
# Wait for a free pooled connection. Unset means "as long as the call's own timeout"; a short value
# makes a saturated pool fail loudly instead of queueing.
# LEASH_HTTP_POOL_TIMEOUT_SECONDS=
# Connection-establishment retries only. httpcore consumes these before any byte of the request is
# written, so a decision POST the platform already received is never replayed.
# LEASH_HTTP_CONNECT_RETRIES=1

# The permission assistant's model (LEASH-101): Apertus on the Swiss {ai} Weeks endpoint. Separate
# from TEAM_API_KEY on purpose — the assistant must have no path to the control layer's credentials.
APERTUS_API_KEY=
# LEASH_MODEL=swiss-ai/Apertus-v1.5-70B
# LEASH_MODEL_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
